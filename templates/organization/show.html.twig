{% extends 'organization/_layout.html.twig' %}
{% import '_partials/ui.html.twig' as ui %}

{% set has_detail = true %}
{% set is_admin = is_granted('ORG_MANAGE', organization) %}

{% block title %}{{ organization.name }}{% endblock %}
{% block detail_title %}{{ organization.name }}{% endblock %}

{% block detail_actions %}
    {% if is_admin %}
        <a href="{{ path('organization_edit', {id: organization.id}) }}" class="btn-icon" aria-label="{{ 'action.edit'|trans }}" title="{{ 'action.edit'|trans }}">
            {{ ux_icon('lucide:pencil', {class: 'size-4', 'aria-hidden': 'true'}) }}
        </a>
        {{ ui.post_button(path('organization_delete', {id: organization.id}), 'delete-organization-' ~ organization.id, 'organization.delete',
            {class: 'btn-icon hover:text-red-600', icon: 'lucide:trash-2', icon_only: true, confirm: 'organization.delete_confirm'}) }}
    {% endif %}
{% endblock %}

{% block detail %}
    <div class="max-w-3xl space-y-8 p-4 lg:p-6">
        <div class="flex items-start gap-4">
            {{ ui.tile(organization.name, organization.logo, organization.color, 'size-16 text-lg') }}
            <div class="min-w-0">
                <p class="text-lg font-semibold">{{ organization.name }}</p>
                {% if organization.description %}<p class="mt-1 whitespace-pre-line text-slate-600">{{ organization.description }}</p>{% endif %}
            </div>
        </div>

        {% set mail = organization.hasFeature('mail') %}
        {% if mail %}
        <section aria-labelledby="accounts-heading">
            <div class="mb-3 flex items-center justify-between gap-2">
                <h3 id="accounts-heading" class="font-semibold">{{ 'mail_account.title'|trans }}</h3>
                {% if is_admin %}
                    <a href="{{ path('mail_account_new', {id: organization.id}) }}" class="btn-secondary">{{ ux_icon('lucide:plus', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'mail_account.new'|trans }}</a>
                {% endif %}
            </div>
            {% if mail_accounts is empty %}
                <p class="text-slate-500">{{ 'mail_account.none'|trans }}</p>
            {% else %}
                <ul role="list" class="card divide-y divide-slate-100">
                    {% for account in mail_accounts %}
                        <li class="flex items-center gap-3 px-4 py-3">
                            {{ ux_icon('lucide:mailbox', {class: 'size-5 text-slate-400', 'aria-hidden': 'true'}) }}
                            <div class="min-w-0 flex-1">
                                <p class="truncate font-medium">{{ account.name }}</p>
                                <p class="truncate text-xs text-slate-500">
                                    {{ account.emailAddress }}
                                    {% if not account.enabled %} · {{ 'mail_account.disabled'|trans }}{% endif %}
                                    {% if account.lastSyncError %} · <span class="text-red-700">{{ 'mail_account.sync_failed'|trans }}</span>{% endif %}
                                </p>
                                {% if is_admin and account.enabled %}
                                    <p class="text-xs text-slate-500">
                                        {{ account.lastSyncAt ? 'mail_account.last_sync'|trans({'%date%': account.lastSyncAt|date('d.m.Y H:i')}) : 'mail_account.never_synced'|trans }}
                                        {% if account.syncProblem == 'stale' %} · <span class="text-amber-800">{{ 'mail_account.sync_stale'|trans }}</span>{% endif %}
                                    </p>
                                    {% if account.lastSyncError %}
                                        <p class="text-xs break-words text-red-700">{{ account.lastSyncError }}</p>
                                    {% endif %}
                                {% endif %}
                            </div>
                            {% if is_admin %}
                                <a href="{{ path('mail_account_edit', {id: account.id}) }}" class="btn-icon" aria-label="{{ 'action.edit'|trans }}: {{ account.name }}" title="{{ 'action.edit'|trans }}">
                                    {{ ux_icon('lucide:settings', {class: 'size-4', 'aria-hidden': 'true'}) }}
                                </a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
        {% endif %}

        {% if mail and is_admin and mail_accounts is not empty %}
            <section aria-labelledby="rules-heading">
                <div class="mb-3 flex items-center justify-between gap-2">
                    <h3 id="rules-heading" class="font-semibold">{{ 'mail_rule.title'|trans }}</h3>
                    <a href="{{ path('mail_rule_new', {id: organization.id}) }}" class="btn-secondary">{{ ux_icon('lucide:plus', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'mail_rule.new'|trans }}</a>
                </div>
                {% if mail_rules is empty %}
                    <p class="text-slate-500">{{ 'mail_rule.none'|trans }}</p>
                {% else %}
                    <ul role="list" class="card divide-y divide-slate-100">
                        {% for rule in mail_rules %}
                            <li class="flex items-center gap-3 px-4 py-3">
                                {{ ux_icon('lucide:wand-sparkles', {class: 'size-5 text-slate-400', 'aria-hidden': 'true'}) }}
                                <div class="min-w-0 flex-1">
                                    <p class="truncate font-medium">{{ rule.name }}{% if not rule.enabled %} <span class="text-xs font-normal text-slate-500">({{ 'mail_rule.disabled'|trans }})</span>{% endif %}</p>
                                    <p class="truncate text-xs text-slate-500">{{ 'mail_rule.summary'|trans({'%field%': rule.field.label|trans, '%needle%': rule.needle}) }}</p>
                                </div>
                                <a href="{{ path('mail_rule_edit', {id: rule.id}) }}" class="btn-icon" aria-label="{{ 'action.edit'|trans }}: {{ rule.name }}" title="{{ 'action.edit'|trans }}">
                                    {{ ux_icon('lucide:settings', {class: 'size-4', 'aria-hidden': 'true'}) }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endif %}

        {% if mail and is_admin and mail_accounts is not empty %}
            <section aria-labelledby="blocked-heading">
                <h3 id="blocked-heading" class="mb-1 font-semibold">{{ 'blocked_sender.title'|trans }}</h3>
                <p class="mb-3 text-sm text-slate-500">{{ 'blocked_sender.intro'|trans }}</p>
                {% if blocked_senders is not empty %}
                    <ul role="list" class="card mb-3 divide-y divide-slate-100">
                        {% for blocked in blocked_senders %}
                            <li class="flex items-center gap-3 px-4 py-2">
                                {{ ux_icon('lucide:ban', {class: 'size-4 text-slate-400', 'aria-hidden': 'true'}) }}
                                <span class="min-w-0 flex-1 truncate">{{ blocked.address }}</span>
                                {{ ui.post_button(path('blocked_sender_delete', {id: blocked.id}), 'delete-blocked-sender-' ~ blocked.id, 'blocked_sender.remove',
                                    {class: 'btn-icon', icon: 'lucide:x', icon_only: true}) }}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                <form method="post" action="{{ path('blocked_sender_add', {id: organization.id}) }}" class="flex gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('blocked-sender-' ~ organization.id) }}">
                    <label for="blocked-address" class="sr-only">{{ 'blocked_sender.address'|trans }}</label>
                    <input type="text" id="blocked-address" name="address" required maxlength="255" class="input min-w-0 flex-1" placeholder="{{ 'blocked_sender.placeholder'|trans }}" aria-describedby="blocked-heading">
                    <button type="submit" class="btn-secondary">{{ 'blocked_sender.add'|trans }}</button>
                </form>
            </section>
        {% endif %}

        {% if is_admin and organization.hasFeature('public_page') %}
            <section aria-labelledby="public-heading">
                <div class="mb-3 flex items-center justify-between gap-2">
                    <h3 id="public-heading" class="font-semibold">{{ 'public.settings.title'|trans }}</h3>
                    <a href="{{ path('public_settings', {id: organization.id}) }}" class="btn-secondary">{{ ux_icon('lucide:globe', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'public.settings.configure'|trans }}</a>
                </div>
                <p class="text-slate-500">{{ 'public.settings.teaser'|trans }}</p>
            </section>
        {% endif %}

        {% if mail %}
        <section aria-labelledby="snippets-heading">
            <div class="mb-3 flex items-center justify-between gap-2">
                <h3 id="snippets-heading" class="font-semibold">{{ 'snippet.title'|trans }}</h3>
                <a href="{{ path('snippet_new', {id: organization.id}) }}" class="btn-secondary">{{ ux_icon('lucide:plus', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'snippet.new'|trans }}</a>
            </div>
            {% if snippets is empty %}
                <p class="text-slate-500">{{ 'snippet.none'|trans }}</p>
            {% else %}
                <ul role="list" class="card divide-y divide-slate-100">
                    {% for snippet in snippets %}
                        <li class="flex items-center gap-3 px-4 py-3">
                            {{ ux_icon('lucide:text-quote', {class: 'size-5 text-slate-400', 'aria-hidden': 'true'}) }}
                            <div class="min-w-0 flex-1">
                                <p class="truncate font-medium">{{ snippet.title }}</p>
                                <p class="truncate text-xs text-slate-500">{{ snippet.body|length > 100 ? snippet.body|slice(0, 100) ~ '…' : snippet.body }}</p>
                            </div>
                            <a href="{{ path('snippet_edit', {id: snippet.id}) }}" class="btn-icon" aria-label="{{ 'action.edit'|trans }}: {{ snippet.title }}" title="{{ 'action.edit'|trans }}">
                                {{ ux_icon('lucide:pencil', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
        {% endif %}

        {% if organization.hasFeature('projects') %}
        <section aria-labelledby="projects-heading">
            <div class="mb-3 flex items-center justify-between gap-2">
                <h3 id="projects-heading" class="font-semibold">{{ 'nav.projects'|trans }}</h3>
                {% if is_admin %}
                    <a href="{{ path('project_new', {organization: organization.id}) }}" class="btn-secondary">{{ ux_icon('lucide:plus', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'project.new'|trans }}</a>
                {% endif %}
            </div>
            {% if org_projects is empty %}
                <p class="text-slate-500">{{ 'project.none'|trans }}</p>
            {% else %}
                <ul role="list" class="flex flex-wrap gap-2">
                    {% for p in org_projects %}
                        <li>
                            <a href="{{ path('project_show', {id: p.id}) }}" class="card flex items-center gap-2 py-1.5 pr-3 pl-1.5 hover:bg-slate-50">
                                {{ ui.tile(p.name, p.image, p.color, 'size-6 text-[10px]') }}
                                <span class="font-medium {{ p.archived ? 'text-slate-500' }}">{{ p.name }}</span>
                                {% if p.archived %}{{ ux_icon('lucide:archive', {class: 'size-3.5 text-slate-400', 'aria-label': 'project.archived'|trans, role: 'img'}) }}{% endif %}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
        {% endif %}

        <section aria-labelledby="members-heading">
            <div class="mb-3 flex items-center justify-between gap-2">
                <h3 id="members-heading" class="font-semibold">{{ 'organization.members'|trans }} <span class="font-normal text-slate-500">({{ organization.members|length }})</span></h3>
                {% if is_admin %}
                    <a href="{{ path('organization_handover', {id: organization.id}) }}" class="btn-secondary">{{ ux_icon('lucide:arrow-right-left', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'handover.title'|trans }}</a>
                {% endif %}
            </div>
            <ul role="list" class="card divide-y divide-slate-100">
                {% for membership in organization.memberships %}
                    {% set member = membership.user %}
                    {% set is_self = member == app.user %}
                    <li class="flex flex-wrap items-center gap-3 px-4 py-3">
                        <twig:Avatar name="{{ member.name }}" image="{{ member.avatar }}" />
                        <div class="min-w-0 flex-1">
                            <p class="truncate font-medium">{{ member.name }}{% if is_self %} <span class="text-slate-500">({{ 'organization.you'|trans }})</span>{% endif %}</p>
                            <p class="truncate text-xs text-slate-500">
                                {% if membership.position %}{{ membership.position }} · {% endif %}{{ member.email }}
                                {% if membership.termEndsOn and not membership.former %} · {{ 'membership.term_until'|trans({'%date%': membership.termEndsOn|date('d.m.Y')}) }}{% endif %}
                            </p>
                            {% if membership.guest and membership.guestProjects is not empty %}
                                <p class="truncate text-xs text-slate-500">{{ 'membership.guest_in'|trans({'%projects%': membership.guestProjects|map(p => p.name)|join(', ')}) }}</p>
                            {% endif %}
                        </div>
                        <div class="flex flex-wrap items-center gap-1.5">
                            {% if membership.former %}
                                <span class="badge bg-slate-100 text-slate-500">{{ 'membership.former'|trans({'%date%': membership.termEndsOn|date('d.m.Y')}) }}</span>
                            {% else %}
                                <span class="badge {{ membership.admin ? 'bg-brand-50 text-brand-700' : (membership.guest ? 'bg-amber-50 text-amber-800' : 'bg-slate-100 text-slate-600') }}">{{ membership.role.label|trans }}</span>
                            {% endif %}
                            {% if membership.votingRight and membership.full %}
                                <span class="badge bg-emerald-50 text-emerald-700">{{ 'organization.voting_right'|trans }}</span>
                            {% endif %}
                            {% if membership.confidant and membership.full %}
                                <span class="badge bg-sky-50 text-sky-800">{{ ux_icon('lucide:lock', {class: 'size-3', 'aria-hidden': 'true'}) }} {{ 'membership.confidant'|trans }}</span>
                            {% endif %}
                        </div>
                        {% if is_admin %}
                            <a href="{{ path('organization_member_edit', {id: organization.id, membership: membership.id}) }}" class="btn-icon"
                               aria-label="{{ 'membership.edit'|trans({'%name%': member.name}) }}" title="{{ 'membership.edit'|trans({'%name%': member.name}) }}">
                                {{ ux_icon('lucide:pencil', {class: 'size-4', 'aria-hidden': 'true'}) }}
                            </a>
                        {% endif %}
                        {% if is_admin or is_self %}
                            {{ ui.post_button(path('organization_member_remove', {id: organization.id, membership: membership.id}), 'member-remove',
                                is_self ? 'organization.leave' : 'organization.remove_member',
                                {class: 'btn-icon hover:text-red-600', icon: is_self ? 'lucide:log-out' : 'lucide:user-minus', icon_only: true,
                                 confirm: is_self ? 'organization.leave_confirm' : 'organization.remove_confirm'}) }}
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>

        {% if is_admin %}
            <section aria-labelledby="invite-heading">
                <h3 id="invite-heading" class="mb-3 font-semibold">{{ 'organization.invite'|trans }}</h3>
                {{ form_start(invite_form, {attr: {class: 'card flex flex-wrap items-end gap-3 p-4'}}) }}
                    {{ form_row(invite_form.email, {row_attr: {class: 'mb-0 min-w-56 flex-1'}}) }}
                    {{ form_row(invite_form.role, {row_attr: {class: 'mb-0'}}) }}
                    {{ form_rest(invite_form) }}
                    <button type="submit" class="btn-primary">{{ ux_icon('lucide:send', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'organization.send_invite'|trans }}</button>
                {{ form_end(invite_form) }}

                {% if invitations is not empty %}
                    <h4 class="mt-4 mb-2 text-sm font-medium text-slate-600">{{ 'organization.pending_invitations'|trans }}</h4>
                    <ul role="list" class="card divide-y divide-slate-100">
                        {% for invitation in invitations %}
                            <li class="flex items-center gap-3 px-4 py-2">
                                {{ ux_icon('lucide:mail', {class: 'size-4 text-slate-400', 'aria-hidden': 'true'}) }}
                                <span class="min-w-0 flex-1 truncate">{{ invitation.email }}</span>
                                <span class="badge bg-slate-100 text-slate-600">{{ invitation.role.label|trans }}</span>
                                <span class="text-xs text-slate-500">{{ invitation.expired ? 'organization.invitation_expired'|trans : invitation.createdAt|date('d.m.Y') }}</span>
                                {{ ui.post_button(path('organization_invitation_revoke', {id: organization.id, invitation: invitation.id}), 'invitation-revoke',
                                    'organization.revoke', {class: 'btn-icon hover:text-red-600', icon: 'lucide:x', icon_only: true}) }}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endif %}
    </div>
{% endblock %}
