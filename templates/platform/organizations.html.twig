{% extends 'platform/_layout.html.twig' %}
{% import '_partials/ui.html.twig' as ui %}

{% block detail_title %}{{ 'platform.organizations'|trans }}{% endblock %}

{% block content %}
    {% if organizations is empty %}
        {{ ui.empty('platform.no_organizations', 'lucide:building-2') }}
    {% else %}
        <div class="overflow-x-auto" tabindex="0" role="region" aria-label="{{ 'platform.organizations'|trans }}">
            <table class="w-full text-left text-sm">
                <caption class="sr-only">{{ 'platform.organizations'|trans }}</caption>
                <thead class="text-xs text-slate-500">
                    <tr>
                        <th scope="col" class="py-1 pr-3 font-medium">{{ 'platform.name'|trans }}</th>
                        <th scope="col" class="py-1 pr-3 font-medium">{{ 'platform.members'|trans }}</th>
                        <th scope="col" class="py-1 pr-3 font-medium">{{ 'platform.admins'|trans }}</th>
                        <th scope="col" class="py-1 font-medium">{{ 'platform.since'|trans }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for organization in organizations %}
                        <tr>
                            <td class="py-2 pr-3 font-medium">{{ organization.name }}</td>
                            <td class="py-2 pr-3">{{ organization.memberships|length }}</td>
                            <td class="py-2 pr-3">{{ organization.admins|map(u => u.name)|join(', ') }}</td>
                            <td class="whitespace-nowrap py-2">{{ organization.createdAt|date('d.m.Y') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
