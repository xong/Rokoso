{% extends 'layout/auth.html.twig' %}

{% block title %}{{ 'agent.authorize.title'|trans }}{% endblock %}

{% block content %}
    <p class="mb-3 text-sm text-slate-700">{{ 'agent.authorize.intro'|trans({'%client%': client.name, '%name%': app.user.name}) }}</p>
    <p class="mb-4 text-xs text-slate-500">{{ 'agent.authorize.redirect'|trans({'%host%': redirect_host}) }}</p>

    {% if organizations is empty %}
        <div role="alert" class="mb-4 rounded-md bg-amber-50 p-3 text-sm text-amber-800">{{ 'agent.no_organization'|trans }}</div>
    {% else %}
        <p class="mb-4 text-sm text-slate-700">{{ 'agent.authorize.organizations'|trans }} {{ organizations|map(o => o.name)|join(', ') }}</p>
    {% endif %}

    <form method="post" data-turbo="false" data-backup="off">
        <fieldset class="mb-4">
            <legend class="label mb-2">{{ 'agent.scopes'|trans }}</legend>
            {% for scope in scopes %}
                <div class="mb-1.5 flex items-start gap-2">
                    <input type="checkbox" name="scopes[]" value="{{ scope.value }}" id="scope-{{ loop.index }}" class="mt-0.5 size-4 accent-brand-600" {{ scope in requested ? 'checked' }}>
                    <label for="scope-{{ loop.index }}" class="text-sm text-slate-700">{{ scope.label|trans }}</label>
                </div>
            {% endfor %}
        </fieldset>
        <p class="mb-4 text-xs text-slate-500">{{ 'agent.drafts_only'|trans }}</p>
        <input type="hidden" name="_token" value="{{ csrf_token('oauth_authorize') }}">
        <div class="flex gap-2">
            <button type="submit" name="allow" value="1" class="btn-primary flex-1">{{ 'agent.authorize.allow'|trans }}</button>
            <button type="submit" name="deny" value="1" class="btn-secondary flex-1">{{ 'agent.authorize.deny'|trans }}</button>
        </div>
    </form>
{% endblock %}
