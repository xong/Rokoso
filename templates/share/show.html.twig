{% extends 'layout/app.html.twig' %}
{% import '_partials/ui.html.twig' as ui %}

{% set show_list = false %}

{% block title %}{{ 'share.title'|trans }}{% endblock %}
{% block detail_title %}{{ 'share.title'|trans }}{% endblock %}

{% block detail %}
    <div class="mx-auto max-w-2xl space-y-4 p-4 lg:p-6">
        {% if shared is null or (shared.files is empty and mail_body is empty and shared.title is empty) %}
            {{ ui.empty('share.empty', 'lucide:share-2') }}
        {% else %}
            {% if shared.files is not empty %}
                <section aria-labelledby="share-files-heading" class="card space-y-4 p-4">
                    <h2 id="share-files-heading" class="text-sm font-semibold">{{ 'share.files'|trans({'%count%': shared.files|length}) }}</h2>
                    <ul class="divide-y divide-slate-100 text-sm">
                        {% for file in shared.files %}
                            <li class="flex items-center gap-2 py-1.5">
                                {{ include('file/_icon.html.twig', {mime: file.mime}) }}
                                <span class="min-w-0 flex-1 truncate">{{ file.name }}</span>
                                <span class="text-slate-500 tabular-nums">{{ file.size|filesize }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                    {% if folders is empty %}
                        <p class="text-sm text-slate-600">{{ 'share.no_folder'|trans }}</p>
                    {% else %}
                        <form method="post" action="{{ path('share_target_save') }}" class="flex flex-wrap items-end gap-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('share-target') }}">
                            <label class="min-w-0 flex-1 text-sm">{{ 'share.folder'|trans }}
                                <select name="folder" class="input mt-1" required>
                                    <option value="">{{ 'share.folder_choose'|trans }}</option>
                                    {% for folder in folders %}
                                        <option value="{{ folder.id }}" {{ folder.id == selected ? 'selected' }}>{{ folder.organization.name }}: {{ folder.path|map(f => f.name)|join(' / ') }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <button type="submit" class="btn-primary">{{ ux_icon('lucide:folder-input', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'share.save'|trans }}</button>
                        </form>
                    {% endif %}
                </section>
            {% endif %}

            {% if mail_body is not empty or shared.title is not empty %}
                <section aria-labelledby="share-text-heading" class="card space-y-3 p-4">
                    <h2 id="share-text-heading" class="text-sm font-semibold">{{ 'share.text'|trans }}</h2>
                    {% if shared.title %}<p class="font-medium">{{ shared.title }}</p>{% endif %}
                    {% if mail_body %}<p class="text-sm break-words whitespace-pre-line text-slate-700">{{ mail_body }}</p>{% endif %}
                    {% if route_available('mail_compose') %}
                        <a class="btn-secondary" href="{{ path('mail_compose', {subject: shared.title, body: mail_body}) }}">
                            {{ ux_icon('lucide:mail-plus', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'share.as_mail'|trans }}
                        </a>
                    {% endif %}
                </section>
            {% endif %}

            {{ ui.post_button(path('share_target_discard'), 'share-target', 'share.discard', {class: 'btn-secondary', icon: 'lucide:trash-2'}) }}
        {% endif %}
    </div>
{% endblock %}
