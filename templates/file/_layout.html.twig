{% extends 'layout/app.html.twig' %}
{% import '_partials/ui.html.twig' as ui %}
{% import _self as tree %}

{#
    Dateien: mittlere Spalte = Ordnerbaum je Organisation (FileController::treeContext),
    rechts Ordnerinhalt bzw. Datei.
#}

{# Ordner im Baum; Unterordner nur entlang des geöffneten Pfads #}
{% macro node(folder, current, open_ids, depth) %}
    {% import _self as tree %}
    {% set active = current and current.id == folder.id %}
    {% set open = folder.id in open_ids %}
    <li>
        <a href="{{ path('folder_show', {id: folder.id}) }}" {% if active %}aria-current="page"{% endif %}
           class="flex items-center gap-2 rounded-md py-1.5 pr-2 text-sm {{ active ? 'bg-brand-50 font-medium text-brand-700' : 'hover:bg-slate-100' }}"
           style="padding-left: {{ 0.5 + depth * 1 }}rem">
            {{ ux_icon(open ? 'lucide:folder-open' : 'lucide:folder', {class: 'size-4 shrink-0 ' ~ (active ? 'text-brand-600' : 'text-slate-500'), 'aria-hidden': 'true'}) }}
            <span class="min-w-0 flex-1 truncate">{{ folder.name }}</span>
            {% if folder.children is not empty and not open %}
                <span class="text-xs text-slate-500" aria-label="{{ 'folder.subfolders'|trans({'%count%': folder.children|length}) }}">{{ folder.children|length }}</span>
            {% endif %}
        </a>
        {% if open and folder.children is not empty %}
            <ul role="list">
                {% for child in folder.children %}{{ tree.node(child, current, open_ids, depth + 1) }}{% endfor %}
            </ul>
        {% endif %}
    </li>
{% endmacro %}

{% block title %}{{ 'nav.files'|trans }}{% endblock %}
{% block list_title %}{{ 'nav.files'|trans }}{% endblock %}
{% block back_url %}{{ current and current.parent ? path('folder_show', {id: current.parent.id}) : path('file_index') }}{% endblock %}

{% block list_actions %}
    <a href="{{ path('folder_new') }}" class="btn-icon" aria-label="{{ 'folder.new_root'|trans }}" title="{{ 'folder.new_root'|trans }}">
        {{ ux_icon('lucide:folder-plus', {class: 'size-5', 'aria-hidden': 'true'}) }}
    </a>
{% endblock %}

{% block list %}
    {% if tree is empty %}
        {{ ui.empty('folder.none', 'lucide:folder', path('folder_new'), 'empty.folder') }}
    {% else %}
        <nav aria-label="{{ 'folder.tree'|trans }}" class="space-y-4 p-2">
            {% for group in tree %}
                <div>
                    <h3 class="flex items-center gap-2 px-2 pb-1 text-xs font-semibold tracking-wide text-slate-500 uppercase">
                        <span class="size-2 rounded-full" style="background-color: {{ group.organization.color }}" aria-hidden="true"></span>
                        {{ group.organization.name }}
                    </h3>
                    <ul role="list">
                        {% for folder in group.folders %}{{ tree.node(folder, current, open_ids, 0) }}{% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </nav>
    {% endif %}
{% endblock %}
