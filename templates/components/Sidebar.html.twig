<nav id="main-nav" aria-label="{{ 'nav.label'|trans }}" data-shell-target="nav"
     class="z-40 flex shrink-0 flex-col border-r border-slate-200 bg-surface transition-[width,transform]
            max-lg:invisible max-lg:fixed max-lg:inset-y-0 max-lg:left-0 max-lg:w-72 max-lg:-translate-x-full
            max-lg:nav-open:visible max-lg:nav-open:translate-x-0
            lg:w-[20vw] lg:min-w-52 lg:max-w-80 lg:collapsed:w-16 lg:collapsed:min-w-16">
    <div class="flex h-14 items-center gap-2 border-b border-slate-200 px-4 lg:collapsed:justify-center lg:collapsed:px-0">
        <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-brand-600 text-xs font-bold text-white" aria-hidden="true">{{ 'app.short_name'|trans }}</span>
        <span class="truncate font-semibold lg:collapsed:sr-only">{{ 'app.name'|trans }}</span>
        <button type="button" data-action="shell#close" aria-label="{{ 'nav.close'|trans }}"
                class="ml-auto grid size-10 place-items-center rounded-md text-slate-500 hover:bg-slate-100 lg:hidden">
            {{ ux_icon('lucide:x', {class: 'size-5', 'aria-hidden': 'true'}) }}
        </button>
    </div>

    <div class="px-2 pt-2">
        <a href="{{ path('search') }}" data-action="palette#open" aria-haspopup="dialog" aria-keyshortcuts="Control+K"
           class="flex items-center gap-3 rounded-md border border-slate-200 px-3 py-1.5 text-slate-500 hover:bg-slate-100 lg:collapsed:justify-center lg:collapsed:border-0 lg:collapsed:px-0 lg:collapsed:py-2">
            {{ ux_icon('lucide:search', {class: 'size-5 shrink-0', 'aria-hidden': 'true'}) }}
            <span class="truncate lg:collapsed:sr-only">{{ 'palette.open'|trans }}</span>
            <kbd class="kbd ml-auto max-lg:hidden lg:collapsed:hidden" aria-hidden="true">Strg K</kbd>
        </a>
    </div>

    <details class="relative px-2 pt-2" data-controller="dropdown" data-action="keydown.esc->dropdown#close">
        <summary class="btn-primary w-full list-none justify-center lg:collapsed:px-0">
            {{ ux_icon('lucide:plus', {class: 'size-5 shrink-0', 'aria-hidden': 'true'}) }}
            <span class="truncate lg:collapsed:sr-only">{{ 'compose_menu.label'|trans }}</span>
        </summary>
        <ul role="list" class="absolute inset-x-2 z-50 mt-1 space-y-0.5 rounded-lg bg-surface p-1 shadow-lg ring-1 ring-slate-200 lg:collapsed:right-auto lg:collapsed:w-56">
            {% for entry in this.compose %}
                <li><a href="{{ path(entry.route, entry.params) }}" class="flex items-center gap-2 rounded-md px-3 py-2 text-slate-700 hover:bg-slate-100">
                    {{ ux_icon(entry.icon, {class: 'size-4 shrink-0 text-slate-500', 'aria-hidden': 'true'}) }}
                    <span class="truncate">{{ entry.label|trans }}</span>
                </a></li>
            {% endfor %}
        </ul>
    </details>

    {% set unread = this.unreadCount %}
    <div class="flex-1 space-y-3 overflow-y-auto p-2 lg:collapsed:overflow-visible">
        {% for group in this.groups %}
            {% if group.label %}
                <h2 id="nav-{{ group.label|replace({'.': '-'}) }}" class="px-3 pt-1 text-xs font-semibold tracking-wide text-slate-500 uppercase lg:collapsed:sr-only">{{ group.label|trans }}</h2>
            {% endif %}
            <ul role="list" class="space-y-0.5" {% if group.label %}aria-labelledby="nav-{{ group.label|replace({'.': '-'}) }}"{% endif %}>
                {% for item in group.items %}
                    <li class="group/item relative">
                        <a href="{{ path(item.route) }}" {% if item.active %}aria-current="{{ item.children is empty ? 'page' : 'true' }}"{% endif %}
                           class="flex items-center gap-3 rounded-md px-3 py-2 font-medium
                                  {{ item.active ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-100' }}
                                  lg:collapsed:justify-center lg:collapsed:px-0">
                            {{ ux_icon(item.icon, {class: 'size-5 shrink-0', 'aria-hidden': 'true'}) }}
                            <span class="truncate lg:collapsed:sr-only">{{ item.label|trans }}</span>
                            {% if item.live %}
                                <span data-live-count="{{ item.live }}" {{ item.badge > 0 ? '' : 'hidden' }} class="ml-auto rounded-full bg-brand-600 px-1.5 text-[10px] leading-4 font-semibold text-white lg:collapsed:absolute lg:collapsed:top-0.5 lg:collapsed:right-0.5"><span data-live-number>{{ item.badge > 99 ? '99+' : item.badge }}</span><span class="sr-only"> {{ item.badge_label|trans }}</span></span>
                            {% endif %}
                        </a>

                        {% if item.children is not empty %}
                            {# Ausgeklappte Navigation: Unterpunkte des aktiven Bereichs inline #}
                            <ul role="list" class="mt-0.5 space-y-0.5 pl-8 lg:collapsed:hidden {{ item.active ? '' : 'hidden' }}">
                                {% for child in item.children %}
                                    <li>{{ _self.child_link(child, unread) }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}

                        {# Eingeklappte Navigation: Name und Unterpunkte als Flyout bei Hover/Fokus #}
                        <div class="absolute top-0 left-full z-50 hidden pl-2 lg:collapsed:group-hover/item:block lg:collapsed:group-focus-within/item:block">
                            <div class="min-w-48 rounded-lg bg-surface p-1 shadow-lg ring-1 ring-slate-200">
                                <p class="px-3 py-1.5 font-semibold text-slate-900" aria-hidden="true">{{ item.label|trans }}</p>
                                {% if item.children is not empty %}
                                    <ul role="list" class="space-y-0.5">
                                        {% for child in item.children %}
                                            <li>{{ _self.child_link(child, unread) }}</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endfor %}
    </div>

    {% if app.user %}
        {% set profile_active = app.request.attributes.get('_route') starts with 'profile_' %}
        <div class="border-t border-slate-200 p-2">
            <div class="group/item relative flex items-center gap-1 lg:collapsed:flex-col">
                <a href="{{ path('profile_edit') }}" {% if profile_active %}aria-current="page"{% endif %}
                   class="flex min-w-0 flex-1 items-center gap-3 rounded-md px-2 py-1.5 {{ profile_active ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-100' }} lg:collapsed:justify-center lg:collapsed:px-0">
                    <twig:Avatar name="{{ app.user.name }}" image="{{ app.user.avatar }}" size="size-8 text-xs" />
                    <span class="min-w-0 lg:collapsed:sr-only">
                        <span class="block truncate font-medium">{{ app.user.name }}</span>
                        <span class="block truncate text-xs text-slate-500">{{ 'nav.profile'|trans }}</span>
                    </span>
                </a>
                <a href="{{ path('app_logout') }}" class="btn-icon" aria-label="{{ 'nav.logout'|trans }}" title="{{ 'nav.logout'|trans }}" data-turbo="false">
                    {{ ux_icon('lucide:log-out', {class: 'size-4', 'aria-hidden': 'true'}) }}
                </a>
            </div>
        </div>
    {% endif %}

    <div class="hidden border-t border-slate-200 p-2 lg:block">
        <button type="button" data-shell-target="collapseToggle" data-action="shell#toggleCollapsed"
                aria-label="{{ 'nav.collapse'|trans }}" title="{{ 'nav.collapse'|trans }}"
                class="flex w-full items-center gap-3 rounded-md px-3 py-2 text-slate-500 hover:bg-slate-100 lg:collapsed:justify-center lg:collapsed:px-0">
            {{ ux_icon('lucide:panel-left-close', {class: 'size-5 shrink-0 lg:collapsed:hidden', 'aria-hidden': 'true'}) }}
            {{ ux_icon('lucide:panel-left-open', {class: 'hidden size-5 shrink-0 lg:collapsed:block', 'aria-hidden': 'true'}) }}
            <span class="truncate lg:collapsed:hidden" aria-hidden="true">{{ 'nav.collapse'|trans }}</span>
        </button>
    </div>
</nav>

{# Mobil: Leiste unten mit den wichtigsten Bereichen; „Mehr“ öffnet die volle Navigation #}
{% set flat = this.groups|map(g => g.items)|reduce((carry, items) => carry|merge(items), []) %}
<nav aria-label="{{ 'nav.bottom'|trans }}"
     class="fixed inset-x-0 bottom-0 z-30 border-t border-slate-200 bg-surface pb-[env(safe-area-inset-bottom)] lg:hidden">
    <ul role="list" class="grid h-14 grid-cols-5">
        {% for item in flat|filter(i => i.route in ['home', 'mail_inbox', 'forum_index', 'calendar_month']) %}
            <li>
                <a href="{{ path(item.route) }}" {% if item.active %}aria-current="page"{% endif %}
                   class="relative flex h-full flex-col items-center justify-center gap-0.5 text-[11px] {{ item.active ? 'font-semibold text-brand-700' : 'text-slate-600' }}">
                    {{ ux_icon(item.icon, {class: 'size-5', 'aria-hidden': 'true'}) }}
                    <span>{{ item.label|trans }}</span>
                    {% set count = item.route == 'mail_inbox' ? unread : item.badge %}
                    {% set live = item.route == 'mail_inbox' ? 'inbox' : item.live %}
                    {% if live %}
                        <span data-live-count="{{ live }}" {{ count > 0 ? '' : 'hidden' }} class="absolute top-1 left-1/2 ml-2 rounded-full bg-brand-600 px-1.5 text-[10px] leading-4 font-semibold text-white"><span data-live-number>{{ count > 99 ? '99+' : count }}</span><span class="sr-only"> {{ (live == 'inbox' ? 'mail.unread' : item.badge_label)|trans }}</span></span>
                    {% endif %}
                </a>
            </li>
        {% endfor %}
        <li>
            <button type="button" data-action="shell#open" aria-controls="main-nav" aria-expanded="false" data-shell-target="openButton"
                    class="flex h-full w-full flex-col items-center justify-center gap-0.5 text-[11px] text-slate-600">
                {{ ux_icon('lucide:menu', {class: 'size-5', 'aria-hidden': 'true'}) }}
                <span>{{ 'nav.more'|trans }}</span>
            </button>
        </li>
    </ul>
</nav>

{% macro child_link(child, unread = 0) %}
    <a href="{{ path(child.route) }}" {% if child.active %}aria-current="page"{% endif %}
       class="flex items-center gap-2 rounded-md px-3 py-1.5 {{ child.active ? 'bg-brand-50 font-medium text-brand-700' : 'text-slate-600 hover:bg-slate-100' }}">
        {{ ux_icon(child.icon, {class: 'size-4 shrink-0', 'aria-hidden': 'true'}) }}
        <span class="truncate">{{ child.label|trans }}</span>
        {% if child.route == 'mail_inbox' %}
            <span data-live-count="inbox" {{ unread > 0 ? '' : 'hidden' }} class="ml-auto rounded-full bg-brand-600 px-1.5 text-[10px] leading-4 font-semibold text-white"><span data-live-number>{{ unread > 99 ? '99+' : unread }}</span><span class="sr-only"> {{ 'mail.unread'|trans }}</span></span>
        {% endif %}
    </a>
{% endmacro %}
