{% extends 'profile/_layout.html.twig' %}

{% block detail_title %}{{ 'profile.section_password'|trans }}{% endblock %}

{% block form %}
    {{ form_start(form) }}
        {{ form_row(form.currentPassword) }}
        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}
        {{ form_rest(form) }}
        <button type="submit" class="btn-primary">{{ 'profile.change_password'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
