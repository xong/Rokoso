{# Vorschlagsliste für @-Erwähnungen; gehört in ein Element mit data-controller="mention" #}
<ul role="listbox" data-mention-target="list" aria-label="{{ 'notification.mention.list'|trans }}" hidden
    class="absolute left-0 z-20 mt-1 max-h-48 w-64 max-w-full overflow-y-auto rounded-md bg-surface py-1 text-sm shadow-lg ring-1 ring-slate-200"></ul>
<span class="sr-only" role="status" data-mention-target="status"></span>
