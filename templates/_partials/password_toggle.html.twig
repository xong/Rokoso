{# Umschalter „Passwort anzeigen“ – innerhalb eines Elements mit data-controller="password-reveal" #}
<button type="button" class="group absolute inset-y-0 right-0 grid w-10 place-items-center rounded-r-md text-slate-500 hover:text-slate-800"
        aria-pressed="false" aria-controls="{{ target }}" aria-label="{{ 'password.show'|trans }}" title="{{ 'password.show'|trans }}"
        data-password-reveal-target="button" data-action="password-reveal#toggle">
    {{ ux_icon('lucide:eye', {class: 'size-4 group-aria-pressed:hidden', 'aria-hidden': 'true'}) }}
    {{ ux_icon('lucide:eye-off', {class: 'hidden size-4 group-aria-pressed:block', 'aria-hidden': 'true'}) }}
</button>
