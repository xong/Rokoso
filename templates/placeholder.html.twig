{% extends 'layout/app.html.twig' %}

{% block title %}{{ title|trans }}{% endblock %}
{% block list_title %}{{ title|trans }}{% endblock %}

{% block list %}
    <p class="p-6 text-center text-slate-500">{{ 'placeholder.coming'|trans({'%phase%': phase}) }}</p>
{% endblock %}

{% block detail %}
