{% extends 'layout/app.html.twig' %}

{% set show_list = false %}
{% set pf = project_filter ? {project: project_filter} : {} %}
{% set weekdays = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'] %}
{% set today = 'now'|date('Y-m-d') %}

{% block title %}{{ 'nav.calendar'|trans }}{% endblock %}
{% block detail_title %}{{ ('calendar.months.' ~ month|date('n'))|trans }} {{ month|date('Y') }}{% endblock %}

{% block detail %}
    {{ include('calendar/_toolbar.html.twig', {
        mode: 'month', ref: month,
        prev_url: path('calendar_month', {month: month|date_modify('-1 month')|date('Y-m')}|merge(pf)),
        next_url: path('calendar_month', {month: month|date_modify('+1 month')|date('Y-m')}|merge(pf)),
        today_url: path('calendar_month', pf),
    }) }}

    <div class="overflow-x-auto">
        <table class="w-full min-w-[42rem] table-fixed border-collapse text-xs">
            <caption class="sr-only">{{ ('calendar.months.' ~ month|date('n'))|trans }} {{ month|date('Y') }}</caption>
            <thead>
                <tr class="border-b border-slate-200 text-slate-500">
                    <th scope="col" class="w-10 py-1.5 font-medium"><abbr title="{{ 'calendar.week_number'|trans }}">{{ 'calendar.kw'|trans }}</abbr></th>
                    {% for wd in weekdays %}<th scope="col" class="py-1.5 font-medium">{{ wd }}</th>{% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for week in weeks %}
                    <tr class="border-b border-slate-100">
                        <th scope="row" class="align-top">
                            <a href="{{ path('calendar_week', {year: week.year, week: week.number}|merge(pf)) }}"
                               class="mt-1 inline-block rounded px-1.5 py-0.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700"
                               aria-label="{{ 'calendar.open_week'|trans({'%week%': week.number}) }}">{{ week.number }}</a>
                        </th>
                        {% for day in week.days %}
                            {% set is_today = day.date|date('Y-m-d') == today %}
                            <td class="h-28 border-l border-slate-100 p-1 align-top {{ day.in_month ? '' : 'bg-slate-50/70 text-slate-400' }}">
                                <a href="{{ path('calendar_day', {date: day.date|date('Y-m-d')}|merge(pf)) }}" {% if is_today %}aria-current="date"{% endif %}
                                   aria-label="{{ day.date|date('d.m.Y') }}"
                                   class="mb-1 inline-grid size-6 place-items-center rounded-full font-medium {{ is_today ? 'bg-brand-600 text-white' : 'hover:bg-slate-100' }}">{{ day.date|date('j') }}</a>
                                <ul role="list" class="space-y-0.5">
                                    {% for o in day.occurrences|slice(0, 4) %}
                                        <li>{{ include('calendar/_chip.html.twig', {o: o, day: day.date}) }}</li>
                                    {% endfor %}
                                    {% if day.occurrences|length > 4 %}
                                        <li><a class="link px-1" href="{{ path('calendar_day', {date: day.date|date('Y-m-d')}|merge(pf)) }}">{{ 'calendar.more'|trans({'%count%': day.occurrences|length - 4}) }}</a></li>
                                    {% endif %}
                                </ul>
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
