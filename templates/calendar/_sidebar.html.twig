{# Mini-Monat mit KW, Monats-/Jahreswahl, Projektfilter und „Demnächst“ #}
{% set pf = project_filter ? {project: project_filter} : {} %}
{% set weekdays = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'] %}
{% set weekdays_sun = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'] %}
{% set today = 'now'|date('Y-m-d') %}
{% set sel_from = sel_from ?? null %}
{% set sel_to = sel_to ?? sel_from %}
{# Monatsnavigation bleibt auf der aktuellen Seite und ändert nur ?month= #}
{% set here = app.request.attributes.get('_route') %}
{% set here_params = app.request.attributes.get('_route_params')|merge(app.request.query.all|filter((v, k) => k != 'pick')) %}
{% set month_label = ('calendar.months.' ~ mini_month|date('n'))|trans ~ ' ' ~ mini_month|date('Y') %}

<div class="p-3">
    <div class="mb-2 flex items-center gap-1">
        <a href="{{ path(here, here_params|merge({month: mini_month|date_modify('-1 month')|date('Y-m')})) }}" class="btn-icon" aria-label="{{ 'calendar.prev_month'|trans }}" title="{{ 'calendar.prev_month'|trans }}">
            {{ ux_icon('lucide:chevron-left', {class: 'size-5', 'aria-hidden': 'true'}) }}
        </a>
        <details class="relative flex-1" data-controller="picker" data-action="keydown.esc->picker#close" {{ app.request.query.has('pick') ? 'open' }}>
            <summary class="cursor-pointer list-none rounded-md px-2 py-1 text-center font-semibold hover:bg-slate-100 [&::-webkit-details-marker]:hidden"
                     aria-label="{{ 'calendar.choose_month'|trans }}: {{ month_label }}">{{ month_label }}</summary>
            {% set year = mini_month|date('Y') %}
            <div class="absolute left-1/2 z-20 mt-1 w-60 -translate-x-1/2 rounded-lg bg-surface p-3 shadow-lg ring-1 ring-slate-200">
                <div class="mb-2 flex items-center justify-between">
                    <a href="{{ path(here, here_params|merge({month: (year - 1) ~ '-' ~ mini_month|date('m'), pick: 1})) }}" class="btn-icon size-8" aria-label="{{ 'calendar.prev_year'|trans }}">{{ ux_icon('lucide:chevron-left', {class: 'size-4', 'aria-hidden': 'true'}) }}</a>
                    <span class="font-semibold tabular-nums">{{ year }}</span>
                    <a href="{{ path(here, here_params|merge({month: (year + 1) ~ '-' ~ mini_month|date('m'), pick: 1})) }}" class="btn-icon size-8" aria-label="{{ 'calendar.next_year'|trans }}">{{ ux_icon('lucide:chevron-right', {class: 'size-4', 'aria-hidden': 'true'}) }}</a>
                </div>
                <ul role="list" class="grid grid-cols-3 gap-1 text-sm">
                    {% for m in 1..12 %}
                        {% set current = m == mini_month|date('n') %}
                        <li>
                            <a href="{{ path(here, here_params|merge({month: year ~ '-' ~ '%02d'|format(m)})) }}" {% if current %}aria-current="date"{% endif %}
                               class="block rounded-md px-2 py-1.5 text-center {{ current ? 'bg-brand-600 text-white' : 'hover:bg-slate-100' }}">{{ ('calendar.months_short.' ~ m)|trans }}</a>
                        </li>
                    {% endfor %}
                </ul>
                <a href="{{ path(here, here_params|merge({month: 'now'|date('Y-m')})) }}" class="link mt-2 block text-center text-sm">{{ 'calendar.this_month'|trans }}</a>
            </div>
        </details>
        <a href="{{ path(here, here_params|merge({month: mini_month|date_modify('+1 month')|date('Y-m')})) }}" class="btn-icon" aria-label="{{ 'calendar.next_month'|trans }}" title="{{ 'calendar.next_month'|trans }}">
            {{ ux_icon('lucide:chevron-right', {class: 'size-5', 'aria-hidden': 'true'}) }}
        </a>
    </div>

    <table class="w-full table-fixed border-collapse text-center text-xs">
        <caption class="sr-only">{{ month_label }}</caption>
        <thead>
            <tr class="text-slate-500">
                <th scope="col" class="w-8 pb-1 font-normal text-slate-500"><abbr title="{{ 'calendar.week_number'|trans }}">{{ 'calendar.kw'|trans }}</abbr></th>
                {% for wd in weekdays %}<th scope="col" class="pb-1 font-medium">{{ wd }}</th>{% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for week in mini_weeks %}
                {% set week_from = (week.days|first).date|date('Y-m-d') %}
                {% set week_selected = sel_from and sel_from == week_from and sel_to != sel_from %}
                <tr class="{{ week_selected ? 'bg-brand-50' : '' }}">
                    <th scope="row" class="p-0.5 font-normal">
                        <a href="{{ path('calendar_week', {year: week.year, week: week.number}|merge(pf)) }}" {% if week_selected %}aria-current="page"{% endif %}
                           class="block rounded py-1.5 tabular-nums {{ week_selected ? 'font-semibold text-brand-700' : 'text-slate-500 hover:bg-slate-100 hover:text-slate-700' }}"
                           aria-label="{{ 'calendar.open_week'|trans({'%week%': week.number}) }}">{{ week.number }}</a>
                    </th>
                    {% for day in week.days %}
                        {% set ymd = day.date|date('Y-m-d') %}
                        {% set is_today = ymd == today %}
                        {% set is_selected = sel_from and sel_from == sel_to and ymd == sel_from %}
                        <td class="p-0.5">
                            <a href="{{ path('calendar_day', {date: ymd}|merge(pf)) }}"
                               {% if is_today %}aria-current="date"{% endif %}
                               aria-label="{{ weekdays_sun[day.date|date('w')] }}, {{ day.date|date('d.m.Y') }}{% if day.count %} – {{ 'calendar.entries'|trans({'%count%': day.count}) }}{% endif %}"
                               class="flex flex-col items-center gap-0.5 rounded-md pt-0.5 pb-1 tabular-nums hover:bg-slate-100">
                                {# Zahl im Kreis, Punkte darunter (nicht darüber gelegt, damit sie in schmalen Spalten nichts verdecken) #}
                                <span class="grid aspect-square w-full max-w-7 place-items-center rounded-full
                                             {{ is_today ? 'bg-brand-600 font-semibold text-white' : (is_selected ? 'bg-brand-100 font-semibold text-brand-800' : (day.in_month ? 'text-slate-700' : 'text-slate-500')) }}">{{ day.date|date('j') }}</span>
                                <span class="flex h-1 max-w-full gap-0.5 overflow-hidden" aria-hidden="true">
                                    {% for c in day.colors %}<span class="size-1 shrink-0 rounded-full" style="background-color: {{ c }}"></span>{% endfor %}
                                </span>
                            </a>
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if projects is not empty %}
        <form method="get" action="{{ path(here, app.request.attributes.get('_route_params')) }}" class="mt-3" data-controller="autosubmit">
            {% for name, value in app.request.query.all|filter((v, k) => k not in ['project', 'pick']) %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
            <label for="calendar-project" class="sr-only">{{ 'nav.projects'|trans }}</label>
            <select id="calendar-project" name="project" class="input py-1.5" data-action="autosubmit#submit">
                <option value="">{{ 'mail.filter.all_projects'|trans }}</option>
                {% for p in projects %}<option value="{{ p.id }}" {{ project_filter == p.id ? 'selected' }}>{{ p.name }}</option>{% endfor %}
            </select>
            <noscript><button type="submit" class="btn-secondary mt-2 py-1">{{ 'action.show'|trans }}</button></noscript>
        </form>
    {% endif %}
</div>

<section aria-labelledby="upcoming-heading" class="border-t border-slate-200 p-3">
    <h2 id="upcoming-heading" class="mb-2 text-xs font-semibold tracking-wide text-slate-500 uppercase">{{ 'calendar.upcoming'|trans }}</h2>
    {% if upcoming is empty %}
        <p class="text-sm text-slate-500">{{ 'calendar.no_upcoming'|trans }}</p>
    {% else %}
        <ul role="list" class="-mx-1 space-y-0.5">
            {% for o in upcoming %}
                <li>
                    <a href="{{ path('calendar_item_show', {id: o.item.id, date: o.day}) }}" class="flex gap-2 rounded-md px-2 py-1.5 hover:bg-slate-50">
                        {% if o.item.task %}
                            {{ ux_icon('lucide:square', {class: 'mt-0.5 size-3.5 shrink-0', style: 'color: ' ~ o.item.color, 'aria-label': 'calendar.task_open'|trans, role: 'img'}) }}
                        {% else %}
                            <span class="mt-1.5 size-2 shrink-0 rounded-full" style="background-color: {{ o.item.color }}" aria-hidden="true"></span>
                        {% endif %}
                        <span class="min-w-0 flex-1">
                            <span class="block truncate text-sm font-medium">{{ o.title }}</span>
                            <span class="block text-xs text-slate-500">
                                {{ o.start|date('Y-m-d') == today ? 'calendar.today'|trans : weekdays_sun[o.start|date('w')] ~ ', ' ~ o.start|date('d.m.') }}
                                {% if o.allDayLike %}· {{ 'calendar.all_day'|trans }}{% else %}· {{ o.start|date('H:i') }}{% endif %}
                            </span>
                        </span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
