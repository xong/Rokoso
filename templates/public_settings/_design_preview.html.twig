{# Skizze eines Designs der öffentlichen Seite (rein dekorativ); design: classic|banner|plain, color: Akzentfarbe #}
<span class="block h-20 overflow-hidden rounded-md bg-slate-50 ring-1 ring-slate-200" aria-hidden="true">
    {% if design == 'banner' %}
        <span class="block h-9 px-2 pt-2" style="background: {{ color }}">
            <span class="block h-1.5 w-10 rounded-full bg-white/80"></span>
            <span class="mt-1.5 block h-2.5 w-16 rounded-full bg-white"></span>
        </span>
        <span class="mx-2 mt-2 block h-4 rounded bg-surface ring-1 ring-slate-200"></span>
        <span class="mx-2 mt-1.5 block h-4 rounded bg-surface ring-1 ring-slate-200"></span>
    {% elseif design == 'plain' %}
        <span class="mx-auto mt-2.5 block h-2.5 w-16 rounded-full bg-slate-400"></span>
        <span class="mx-auto mt-1.5 block h-1 w-20 rounded-full" style="background: {{ color }}"></span>
        <span class="mx-6 mt-3 block h-1 rounded-full bg-slate-300"></span>
        <span class="mx-6 mt-1.5 block h-1 rounded-full bg-slate-300"></span>
        <span class="mx-6 mt-1.5 block h-1 w-1/2 rounded-full bg-slate-300"></span>
    {% else %}
        <span class="block border-t-4 bg-surface px-2 py-1.5 ring-1 ring-slate-200" style="border-color: {{ color }}">
            <span class="block h-2 w-12 rounded-full bg-slate-400"></span>
        </span>
        <span class="mx-2 mt-2 block h-4 rounded bg-surface ring-1 ring-slate-200"></span>
        <span class="mx-2 mt-1.5 block h-4 rounded bg-surface ring-1 ring-slate-200"></span>
    {% endif %}
</span>
