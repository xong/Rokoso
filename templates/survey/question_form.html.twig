{% extends 'survey/_layout.html.twig' %}

{% set has_detail = true %}

{% block detail_title %}{{ 'survey.question.edit'|trans }}{% endblock %}
{% block back_url %}{{ path('survey_show', {id: survey.id}) }}{% endblock %}

{% block detail %}
    <div class="max-w-2xl p-4 lg:p-6">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_rest(form) }}
            <div class="flex gap-2">
                <button type="submit" class="btn-primary">{{ 'action.save'|trans }}</button>
                <a href="{{ path('survey_show', {id: survey.id, _fragment: 'questions'}) }}" class="btn-secondary">{{ 'action.cancel'|trans }}</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
