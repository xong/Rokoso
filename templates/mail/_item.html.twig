{# Eintrag der Nachrichtenliste. Variablen: m, unread, active, folder, filter #}
{% import '_partials/ui.html.twig' as ui %}
{% set sender = m.internal and m.author ? m.author.name : m.fromLabel %}
{% set org_color = m.organization ? m.organization.color : '#94a3b8' %}
<div class="group/msg relative border-b border-slate-100 {{ active ? 'bg-brand-50' : 'hover:bg-slate-50' }}">
    <a href="{{ path('mail_show', {folder: folder, id: m.id}|merge(filter.params)) }}" {% if active %}aria-current="page"{% endif %}
       class="flex gap-3 border-l-4 py-2.5 pr-3 pl-2" style="border-left-color: {{ org_color }}">
        {% if m.internal and m.author %}
            <twig:Avatar name="{{ m.author.name }}" image="{{ m.author.avatar }}" size="size-9 text-xs" />
        {% else %}
            <twig:SenderAvatar address="{{ m.fromAddress }}" name="{{ m.fromLabel }}" />
        {% endif %}
        <span class="min-w-0 flex-1">
            <span class="flex items-baseline gap-2">
                {% if unread %}<span class="size-2 shrink-0 self-center rounded-full bg-brand-600" aria-hidden="true"></span><span class="sr-only">{{ 'mail.unread'|trans }}:</span>{% endif %}
                <span class="min-w-0 flex-1 truncate {{ unread ? 'font-semibold text-slate-900' : 'text-slate-700' }}">
                    {% if folder == 'sent' and not m.internal %}{{ 'mail.to_prefix'|trans }} {{ (m.toRecipients|first).name|default((m.toRecipients|first).address|default('–')) }}{% else %}{{ sender }}{% endif %}
                </span>
                <time datetime="{{ m.date|date('c') }}" class="shrink-0 text-xs text-slate-500">{{ m.date|short_date }}</time>
            </span>
            <span class="block truncate {{ unread ? 'font-semibold' : '' }}">{{ m.subject ?: 'mail.no_subject'|trans }}</span>
            <span class="flex items-center gap-1.5">
                <span class="min-w-0 flex-1 truncate text-xs text-slate-500">{{ m.snippet }}</span>
                {% if m.internal %}
                    <span title="{{ 'mail.icon.internal'|trans }}">{{ ux_icon('lucide:message-square', {class: 'size-3.5 text-slate-400', 'aria-label': 'mail.icon.internal'|trans, role: 'img'}) }}</span>
                {% endif %}
                {% if m.hasAttachments %}
                    <span title="{{ 'mail.icon.attachment'|trans }}">{{ ux_icon('lucide:paperclip', {class: 'size-3.5 text-slate-400', 'aria-label': 'mail.icon.attachment'|trans, role: 'img'}) }}</span>
                {% endif %}
                {% if m.assignees is empty %}
                    <span title="{{ 'mail.icon.unassigned'|trans }}">{{ ux_icon('lucide:user-x', {class: 'size-3.5 text-amber-500', 'aria-label': 'mail.icon.unassigned'|trans, role: 'img'}) }}</span>
                {% elseif m.isAssignedTo(app.user) %}
                    <span title="{{ 'mail.icon.mine'|trans }}">{{ ux_icon('lucide:user-check', {class: 'size-3.5 text-emerald-600', 'aria-label': 'mail.icon.mine'|trans, role: 'img'}) }}</span>
                {% endif %}
                {% if m.project %}
                    <span class="badge max-w-24 truncate bg-slate-100 text-slate-600"><span class="size-2 shrink-0 rounded-full" style="background-color: {{ m.project.color }}" aria-hidden="true"></span>{{ m.project.name }}</span>
                {% endif %}
            </span>
        </span>
    </a>
    {# Funktionsleiste bei Hover/Fokus #}
    {% set fields = {folder: folder, return: 'list'} %}
    {% for key, value in filter.params %}{% set fields = fields|merge({('params[' ~ key ~ ']'): value}) %}{% endfor %}
    {% set compose_route = m.internal ? 'mail_message_new' : 'mail_compose' %}
    <div class="absolute top-1.5 right-2 hidden items-center gap-0.5 rounded-md bg-white p-0.5 shadow-sm ring-1 ring-slate-200 group-focus-within/msg:flex group-hover/msg:flex">
        <a href="{{ path('mail_show', {folder: folder, id: m.id, open: 'project'}|merge(filter.params)) }}" class="btn-icon size-7" aria-label="{{ 'mail.toolbar.project'|trans }}" title="{{ 'mail.toolbar.project'|trans }}">{{ ux_icon('lucide:folder-kanban', {class: 'size-4', 'aria-hidden': 'true'}) }}</a>
        <a href="{{ path('mail_show', {folder: folder, id: m.id, open: 'assignees'}|merge(filter.params)) }}" class="btn-icon size-7" aria-label="{{ 'mail.toolbar.assignees'|trans }}" title="{{ 'mail.toolbar.assignees'|trans }}">{{ ux_icon('lucide:users', {class: 'size-4', 'aria-hidden': 'true'}) }}</a>
        {{ ui.post_button(path('mail_assign_me', {id: m.id}), 'mail-action', m.isAssignedTo(app.user) ? 'mail.assignees.unassign_me' : 'mail.assignees.assign_me',
            {class: 'btn-icon size-7', icon: m.isAssignedTo(app.user) ? 'lucide:user-minus' : 'lucide:user-plus', icon_only: true, fields: fields}) }}
        {% if folder != 'trash' %}
            <a href="{{ path(compose_route, {reply: m.id}) }}" class="btn-icon size-7" aria-label="{{ 'mail.reply'|trans }}" title="{{ 'mail.reply'|trans }}">{{ ux_icon('lucide:reply', {class: 'size-4', 'aria-hidden': 'true'}) }}</a>
            {% if not m.internal %}
                <a href="{{ path('mail_compose', {forward: m.id}) }}" class="btn-icon size-7" aria-label="{{ 'mail.forward'|trans }}" title="{{ 'mail.forward'|trans }}">{{ ux_icon('lucide:forward', {class: 'size-4', 'aria-hidden': 'true'}) }}</a>
            {% endif %}
        {% endif %}
        {{ ui.post_button(path('mail_trash_message', {id: m.id}), 'mail-action', m.trashed ? 'mail.restore' : 'mail.trash',
            {class: 'btn-icon size-7 hover:text-red-600', icon: m.trashed ? 'lucide:archive-restore' : 'lucide:trash-2', icon_only: true, fields: fields}) }}
    </div>
</div>
