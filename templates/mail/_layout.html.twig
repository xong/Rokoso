{% extends 'layout/app.html.twig' %}
{% import '_partials/ui.html.twig' as ui %}

{% set folder_title = ('nav.mail_' ~ folder) %}
{% set list_route = folder == 'inbox' ? 'mail_inbox' : 'mail_' ~ folder %}

{% block title %}{{ folder_title|trans }}{% endblock %}
{% block list_title %}{{ folder_title|trans }}{% endblock %}
{% block back_url %}{{ path(list_route, filter.params) }}{% endblock %}

{% block list_actions %}
    {% if folder == 'inbox' and accounts is not empty %}
        {{ ui.post_button(path('mail_sync'), 'mail-sync', 'mail.sync', {class: 'btn-icon', icon: 'lucide:refresh-cw', icon_only: true}) }}
    {% endif %}
    <a href="{{ path('mail_compose') }}" class="btn-icon" aria-label="{{ 'nav.mail_compose'|trans }}" title="{{ 'nav.mail_compose'|trans }}">
        {{ ux_icon('lucide:square-pen', {class: 'size-5', 'aria-hidden': 'true'}) }}
    </a>
{% endblock %}

{% block list %}
    {# Filter über der Liste (GET, sendet bei Änderung automatisch ab) #}
    <form method="get" action="{{ path(list_route) }}" role="search" aria-label="{{ 'mail.filter.label'|trans }}"
          class="sticky top-0 z-10 space-y-2 border-b border-slate-200 bg-surface/95 p-2 backdrop-blur" data-controller="autosubmit">
        <div class="relative">
            {{ ux_icon('lucide:search', {class: 'pointer-events-none absolute top-2.5 left-2.5 size-4 text-slate-400', 'aria-hidden': 'true'}) }}
            <label for="mail-q" class="sr-only">{{ 'action.search'|trans }}</label>
            <input type="search" id="mail-q" name="q" value="{{ filter.query }}" placeholder="{{ 'mail.filter.search'|trans }}" class="input pl-8">
        </div>
        <div class="flex gap-2">
            <label for="mail-show" class="sr-only">{{ 'mail.filter.show'|trans }}</label>
            <select id="mail-show" name="show" class="input min-w-0 flex-1 py-1.5" data-action="autosubmit#submit">
                {% for option in ['all', 'unassigned', 'mine', 'unread', 'internal'] %}
                    <option value="{{ option }}" {{ filter.show == option ? 'selected' }}>{{ ('mail.filter.' ~ option)|trans }}</option>
                {% endfor %}
            </select>
            {% if projects is not empty %}
                <label for="mail-project" class="sr-only">{{ 'nav.projects'|trans }}</label>
                <select id="mail-project" name="project" class="input min-w-0 flex-1 py-1.5" data-action="autosubmit#submit">
                    <option value="">{{ 'mail.filter.all_projects'|trans }}</option>
                    {% for p in projects %}
                        <option value="{{ p.id }}" {{ filter.project == p.id ? 'selected' }}>{{ p.name }}</option>
                    {% endfor %}
                </select>
            {% endif %}
            {% if accounts|length > 1 %}
                <label for="mail-account" class="sr-only">{{ 'mail_account.title'|trans }}</label>
                <select id="mail-account" name="account" class="input min-w-0 flex-1 py-1.5" data-action="autosubmit#submit">
                    <option value="">{{ 'mail.filter.all_accounts'|trans }}</option>
                    {% for a in accounts %}
                        <option value="{{ a.id }}" {{ filter.account == a.id ? 'selected' }}>{{ a.name }}</option>
                    {% endfor %}
                </select>
            {% endif %}
            <noscript><button type="submit" class="btn-secondary">{{ 'action.search'|trans }}</button></noscript>
        </div>
        {% if filter.active %}
            <a href="{{ path(list_route) }}" class="link text-xs">{{ 'mail.filter.reset'|trans }}</a>
        {% endif %}
    </form>

    {% if messages is empty %}
        {{ ui.empty(accounts is empty and folder == 'inbox' and not filter.active ? 'mail.no_accounts' : (folder == 'inbox' and not filter.active ? 'mail.inbox_zero' : 'mail.empty'), folder == 'inbox' and not filter.active ? 'lucide:party-popper' : 'lucide:inbox') }}
        {% if accounts is empty and folder == 'inbox' %}
            <p class="-mt-8 px-6 pb-8 text-center"><a class="link" href="{{ path('organization_index') }}">{{ 'mail.setup_account'|trans }}</a></p>
        {% endif %}
    {% else %}
        {# Mehrfachauswahl: Kontrollkästchen der Einträge gehören zum Formular bulk-form #}
        <div data-controller="bulk" data-bulk-selected-label="{{ 'mail.bulk.selected'|trans }}">
        <form id="bulk-form" method="post" action="{{ path('mail_action') }}" hidden data-bulk-target="bar"
              class="sticky top-[5.5rem] z-10 flex flex-wrap items-center gap-1 border-b border-brand-200 bg-brand-50 px-2 py-1.5 text-sm" aria-label="{{ 'mail.bulk.label'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('mail-action') }}">
            <input type="hidden" name="folder" value="{{ folder }}">
            <input type="hidden" name="return" value="list">
            {% for key, value in filter.params %}<input type="hidden" name="params[{{ key }}]" value="{{ value }}">{% endfor %}
            <label class="flex items-center gap-1.5 px-1">
                <input type="checkbox" class="size-4" data-bulk-target="all" data-action="bulk#toggleAll">
                <span class="sr-only">{{ 'mail.bulk.select_all'|trans }}</span>
            </label>
            <span class="mr-auto font-medium" data-bulk-target="count" aria-live="polite"></span>
            {% if folder == 'done' %}
                <button type="submit" name="action" value="reopen" class="btn-icon size-8" title="{{ 'mail.reopen'|trans }}" aria-label="{{ 'mail.reopen'|trans }}">{{ ux_icon('lucide:rotate-ccw', {class: 'size-4', 'aria-hidden': 'true'}) }}</button>
            {% elseif folder != 'trash' %}
                <button type="submit" name="action" value="done" class="btn-icon size-8" title="{{ 'mail.done'|trans }}" aria-label="{{ 'mail.done'|trans }}">{{ ux_icon('lucide:check', {class: 'size-4', 'aria-hidden': 'true'}) }}</button>
            {% endif %}
            <button type="submit" name="action" value="read" class="btn-icon size-8" title="{{ 'mail.mark_read'|trans }}" aria-label="{{ 'mail.mark_read'|trans }}">{{ ux_icon('lucide:mail-open', {class: 'size-4', 'aria-hidden': 'true'}) }}</button>
            <button type="submit" name="action" value="unread" class="btn-icon size-8" title="{{ 'mail.mark_unread'|trans }}" aria-label="{{ 'mail.mark_unread'|trans }}">{{ ux_icon('lucide:mail', {class: 'size-4', 'aria-hidden': 'true'}) }}</button>
            <button type="submit" name="action" value="assign_me" class="btn-icon size-8" title="{{ 'mail.assignees.assign_me'|trans }}" aria-label="{{ 'mail.assignees.assign_me'|trans }}">{{ ux_icon('lucide:user-plus', {class: 'size-4', 'aria-hidden': 'true'}) }}</button>
            {% if folder == 'trash' %}
                <button type="submit" name="action" value="restore" class="btn-icon size-8" title="{{ 'mail.restore'|trans }}" aria-label="{{ 'mail.restore'|trans }}">{{ ux_icon('lucide:archive-restore', {class: 'size-4', 'aria-hidden': 'true'}) }}</button>
            {% else %}
                <button type="submit" name="action" value="trash" class="btn-icon size-8 hover:text-red-600" title="{{ 'mail.trash'|trans }}" aria-label="{{ 'mail.trash'|trans }}">{{ ux_icon('lucide:trash-2', {class: 'size-4', 'aria-hidden': 'true'}) }}</button>
            {% endif %}
            {% if projects is not empty %}
                <span class="flex w-full items-center gap-1">
                    <label for="bulk-project" class="sr-only">{{ 'mail.project.label'|trans }}</label>
                    <select id="bulk-project" name="project" class="input min-w-0 flex-1 py-1">
                        <option value="">{{ 'mail.project.none'|trans }}</option>
                        {% for p in projects %}<option value="{{ p.id }}">{{ p.name }}</option>{% endfor %}
                    </select>
                    <button type="submit" name="action" value="project" class="btn-secondary py-1">{{ 'mail.bulk.set_project'|trans }}</button>
                </span>
            {% endif %}
        </form>
        {% set current_group = null %}
        <ul role="list">
            {% for m in messages %}
                {% set group = date_group(m.date) %}
                {% if group != current_group %}
                    {% set current_group = group %}
                    <li role="presentation" class="border-b border-slate-100 bg-slate-50 px-4 py-1 text-xs font-semibold tracking-wide text-slate-500 uppercase">
                        {{ ('mail.group.' ~ group)|trans }}
                    </li>
                {% endif %}
                <li>{{ include('mail/_item.html.twig', {m: m, unread: read_ids[m.id] is not defined, active: message is defined and message.id == m.id}) }}</li>
            {% endfor %}
        </ul>
        {% if has_more or filter.page > 1 %}
            <nav aria-label="{{ 'mail.pagination'|trans }}" class="flex justify-between p-3">
                {% if filter.page > 1 %}<a class="btn-secondary" href="{{ path(list_route, filter.params|merge({page: filter.page - 1})) }}">{{ 'mail.newer'|trans }}</a>{% else %}<span></span>{% endif %}
                {% if has_more %}<a class="btn-secondary" href="{{ path(list_route, filter.params|merge({page: filter.page + 1})) }}">{{ 'mail.older'|trans }}</a>{% endif %}
            </nav>
        {% endif %}
        </div>
    {% endif %}
{% endblock %}
