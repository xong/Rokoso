{% extends 'public/_layout.html.twig' %}

{% block title %}{{ 'public.subscribe.title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <h1 class="mb-2 text-2xl font-semibold">{{ 'public.subscribe.title'|trans }}</h1>
    <p class="mb-6 text-slate-600">{{ 'public.subscribe.intro'|trans }}</p>
    {{ form_start(form, {attr: {class: 'card p-6'}}) }}
        {{ form_errors(form) }}
        <div class="grid gap-x-4 sm:grid-cols-2">
            {{ form_row(form.name) }}
            {{ form_row(form.email) }}
        </div>
        {{ form_row(form.groups) }}
        {{ include('public/_consent.html.twig') }}
        {{ form_rest(form) }}
        <button type="submit" class="btn-primary">{{ 'public.subscribe.submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
