{% extends 'public/_layout.html.twig' %}

{# Startseite mit allen Abschnitten; die Navigation springt per Anker dorthin (Reihenfolge in PublicPage::sections()) #}
{% block content %}
    {% set sections = public_sections(settings) %}
    {% set home_url = path('public_home', {slug: settings.slug, embed: embed ? 1 : null}) %}
    {% if not title_in_header %}
        <h1 class="mb-4 text-2xl font-semibold">{{ settings.organization.name }}</h1>
    {% endif %}
    {% if settings.offers('info') and settings.intro %}
        <div class="markdown mb-8">{{ settings.intro|markdown }}</div>
    {% endif %}

    <div class="space-y-10">
        {% if sections.events is defined %}
            <section id="events" aria-labelledby="events-heading" class="scroll-mt-6">
                <h2 id="events-heading" class="mb-3 text-lg font-semibold">{{ 'public.home.events'|trans }}</h2>
                <ul role="list" class="card divide-y divide-slate-100">
                    {% for o in events %}
                        <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
                            <span class="w-36 shrink-0 text-slate-600">{{ o.start|date(o.item.allDay ? 'd.m.Y' : 'd.m.Y H:i') }}</span>
                            <a href="{{ path('public_event', {slug: settings.slug, id: o.item.id}) }}" class="link min-w-0 flex-1">{{ o.title }}</a>
                            {% if o.item.signupOpen %}<span class="badge bg-emerald-50 text-emerald-700">{{ 'public.event.signup_open'|trans }}</span>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% if sections.surveys is defined %}
            <section id="surveys" aria-labelledby="surveys-heading" class="scroll-mt-6">
                <h2 id="surveys-heading" class="mb-3 text-lg font-semibold">{{ 'public.home.surveys'|trans }}</h2>
                <ul role="list" class="card divide-y divide-slate-100">
                    {% for s in surveys %}
                        <li class="px-4 py-3"><a href="{{ path('public_survey', {slug: settings.slug, token: s.token}) }}" class="link">{{ s.title }}</a></li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% if sections.resolutions is defined %}
            <section id="resolutions" aria-labelledby="resolutions-heading" class="scroll-mt-6">
                <h2 id="resolutions-heading" class="mb-3 text-lg font-semibold">{{ 'public.home.resolutions'|trans }}</h2>
                <ul role="list" class="space-y-3">
                    {% for r in resolutions %}
                        <li class="card p-4">
                            <details>
                                <summary class="cursor-pointer font-medium">{{ r.number ? r.number ~ ' · ' }}{{ r.title }} <span class="font-normal text-slate-500">({{ r.decidedOn|date('d.m.Y') }})</span></summary>
                                <div class="markdown mt-3">{{ r.text|markdown }}</div>
                            </details>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% if contact_form %}
            <section id="contact" aria-labelledby="contact-heading" class="scroll-mt-6">
                <h2 id="contact-heading" class="mb-1 text-lg font-semibold">{{ 'public.contact.title'|trans }}</h2>
                <p class="mb-4 text-slate-600">{{ 'public.contact.intro'|trans({'%name%': settings.organization.name}) }}</p>
                {{ include('public/_contact_form.html.twig', {form: contact_form, action: home_url ~ '#contact'}) }}
            </section>
        {% endif %}

        {% if subscribe_form %}
            <section id="subscribe" aria-labelledby="subscribe-heading" class="scroll-mt-6">
                <h2 id="subscribe-heading" class="mb-1 text-lg font-semibold">{{ 'public.subscribe.title'|trans }}</h2>
                <p class="mb-4 text-slate-600">{{ 'public.subscribe.intro'|trans }}</p>
                {{ include('public/_subscribe_form.html.twig', {form: subscribe_form, action: home_url ~ '#subscribe'}) }}
            </section>
        {% endif %}

        {% if sections.confidential is defined %}
            <section id="confidential" aria-labelledby="confidential-heading" class="scroll-mt-6">
                <h2 id="confidential-heading" class="mb-1 text-lg font-semibold">{{ 'public.confidential.title'|trans }}</h2>
                <p class="mb-4 text-slate-600">{{ 'public.confidential.intro'|trans({'%name%': settings.organization.name}) }}</p>
                <a href="{{ path('public_confidential', {slug: settings.slug}) }}" class="btn-secondary">{{ ux_icon('lucide:lock', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'public.home.confidential_start'|trans }}</a>
            </section>
        {% endif %}
    </div>
{% endblock %}
