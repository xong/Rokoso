{% extends 'layout/auth.html.twig' %}

{% block title %}{{ 'invitation.title'|trans }}{% endblock %}

{% block content %}
    {% if invitation is null %}
        <p class="text-slate-700">{{ 'invitation.invalid'|trans }}</p>
    {% else %}
        <p class="mb-2 text-slate-700">{{ 'invitation.text'|trans({'%organization%': invitation.organization.name, '%inviter%': invitation.invitedBy ? invitation.invitedBy.name : '–'}) }}</p>
        <p class="mb-4 text-sm text-slate-600">{{ 'invitation.for'|trans({'%email%': invitation.email}) }}</p>
        {% if app.user %}
            {% if already_member %}
                <p class="mb-4 text-slate-600">{{ 'invitation.already_member'|trans }}</p>
                <a class="btn-primary w-full" href="{{ path('organization_show', {id: invitation.organization.id}) }}">{{ 'invitation.open'|trans }}</a>
            {% elseif wrong_account %}
                <p class="mb-4 text-slate-700">{{ 'invitation.wrong_account'|trans({'%current%': app.user.email}) }}</p>
                <a class="btn-secondary w-full" href="{{ path('app_logout') }}" data-turbo="false">{{ 'invitation.logout'|trans }}</a>
            {% else %}
                <form method="post" action="{{ path('invitation_accept', {token: invitation.token}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('invitation-accept') }}">
                    <button type="submit" class="btn-primary w-full">{{ 'invitation.accept'|trans }}</button>
                </form>
            {% endif %}
        {% elseif has_account %}
            <div class="space-y-2">
                <a class="btn-primary w-full" href="{{ path('app_login') }}">{{ 'invitation.login_to_accept'|trans }}</a>
            </div>
        {% else %}
            <div class="space-y-2">
                <a class="btn-primary w-full" href="{{ path('app_register') }}">{{ 'invitation.register'|trans }}</a>
                <a class="btn-secondary w-full" href="{{ path('app_login') }}">{{ 'invitation.login'|trans }}</a>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
