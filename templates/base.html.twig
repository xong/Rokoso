<!DOCTYPE html>
{# Farbschema aus dem Profil; "system" folgt prefers-color-scheme (siehe app.css). Öffentliche Seiten setzen page_theme aus ihren Einstellungen #}
{% set theme = page_theme|default(app.user.theme.value ?? 'system') %}
<html lang="{{ app.request.locale }}" class="h-full" data-theme="{{ theme }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}{% endblock %}{% if block('title') is not empty %} · {% endif %}{{ 'app.name'|trans }}</title>
        <meta name="color-scheme" content="{{ theme == 'system' ? 'light dark' : theme }}">
        <meta name="theme-color" content="#417230">
        <meta name="description" content="{{ 'pwa.description'|trans }}">
        {# Aktionen, die auf dieselbe Seite zurückleiten, aktualisieren sie per Morphing statt neu zu laden (Scroll und Fokus bleiben) #}
        <meta name="turbo-refresh-method" content="morph">
        <meta name="turbo-refresh-scroll" content="preserve">
        {# with the session cookie: colors follow the color scheme of the profile (PwaController) #}
        <link rel="manifest" href="{{ path('pwa_manifest') }}" crossorigin="use-credentials">
        <link rel="icon" href="{{ public_file('/favicon.ico') }}" sizes="48x48">
        <link rel="icon" href="{{ public_file('/favicon.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ public_file('/app-icons/apple-touch-icon.png') }}">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-title" content="{{ 'app.name'|trans }}">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}" data-turbo-track="reload">
        {% endblock %}
        {% block javascripts %}
            {# one bundled file (app:js:build); hash in the URL, Turbo reloads the page when it changes #}
            <script type="module" src="{{ asset('build/app.js') }}" data-turbo-track="reload"></script>
        {% endblock %}
    </head>
    <body class="h-full bg-slate-50 text-sm text-slate-900 antialiased">
        {% block body %}{% endblock %}
        {# Texte für automatisches Speichern (autosave-form) und die Sicherung im Browser (form_backup.js) #}
        {% if app.user %}
            <div id="form-texts" hidden data-user="{{ app.user.id }}" data-saved="{{ 'form.autosave.saved'|trans }}" data-invalid="{{ 'form.autosave.invalid'|trans }}"
                 data-failed="{{ 'form.autosave.failed'|trans }}" data-restored="{{ 'form.backup.restored'|trans }}" data-discard="{{ 'form.backup.discard'|trans }}"></div>
        {% endif %}
    </body>
</html>
