{% extends 'base.html.twig' %}

{#
    Dreispaltiges App-Layout: Navigation (20 %) · Liste (25 %, verschiebbar über panel_width('list')) · Detail (Rest).
    Kind-Templates füllen die Blöcke `list` und `detail`.
    Mobil ist immer nur eine Spalte sichtbar: die Liste, oder – wenn has_detail – die Detailansicht.
#}
{% set has_detail = has_detail ?? false %}
{# show_list = false: nur Detailspalte in voller Breite (z. B. Kalender) #}
{% set show_list = show_list ?? true %}
{% set nav_collapsed = app.request.cookies.get('nav_collapsed') == '1' %}

{% block body %}
    {{ include('_partials/flashes.html.twig') }}
    <a href="#main" class="sr-only z-50 rounded-md bg-surface px-4 py-2 shadow focus:not-sr-only focus:fixed focus:top-2 focus:left-2">{{ 'nav.skip_to_content'|trans }}</a>

    <div class="flex h-dvh overflow-hidden max-lg:pb-[calc(3.5rem+env(safe-area-inset-bottom))]"
         data-controller="shell palette live-counts"
         data-live-counts-url-value="{{ path('counts') }}"
         data-shell-collapsed-value="{{ nav_collapsed ? 'true' : 'false' }}"
         data-shell-collapse-label-value="{{ 'nav.collapse'|trans }}"
         data-shell-expand-label-value="{{ 'nav.expand'|trans }}"
         data-collapsed="{{ nav_collapsed ? 'true' : 'false' }}"
         data-action="keydown.esc@window->shell#close">

        <twig:Sidebar />
        <div class="fixed inset-0 z-30 hidden bg-black/40 max-lg:nav-open:block" data-action="click->shell#close" aria-hidden="true"></div>

        <main id="main" tabindex="-1" data-shell-target="main" class="flex min-w-0 flex-1">
            {% if show_list %}
            {% set list_panel = panel_width('list') %}
            <section id="list-panel" aria-labelledby="list-heading"
                     class="relative flex w-full min-w-0 shrink-0 flex-col border-r border-slate-200 bg-surface lg:w-[var(--panel-width,25vw)] lg:min-w-48{{ has_detail ? ' max-lg:hidden' }}"
                     {% if list_panel.value %}style="--panel-width: {{ list_panel.value }}%"{% endif %}
                     data-controller="panel-resize" data-panel-resize-name-value="list"
                     data-panel-resize-min-value="{{ list_panel.min }}" data-panel-resize-max-value="{{ list_panel.max }}">
                {{ include('_partials/panel_handle.html.twig', {panel: list_panel, controls: 'list-panel', label: 'nav.resize_list', edge: 'right', show: 'lg:block'}) }}
                <header class="flex h-14 shrink-0 items-center gap-2 border-b border-slate-200 px-3">
                    <button type="button" data-shell-target="openButton" data-action="shell#open"
                            aria-label="{{ 'nav.open'|trans }}" aria-controls="main-nav" aria-expanded="false"
                            class="grid size-10 place-items-center rounded-md text-slate-600 hover:bg-slate-100 lg:hidden">
                        {{ ux_icon('lucide:menu', {class: 'size-5', 'aria-hidden': 'true'}) }}
                    </button>
                    <h1 id="list-heading" class="truncate text-base font-semibold">{% block list_title %}{% endblock %}</h1>
                    <div class="ml-auto flex items-center gap-1">{% block list_actions %}{% endblock %}</div>
                </header>
                <div class="min-h-0 flex-1 overflow-y-auto">
                    {% block list %}{% endblock %}
                </div>
            </section>
            {% endif %}

            <section aria-labelledby="detail-heading" class="flex min-w-0 flex-1 flex-col bg-surface{{ has_detail or not show_list ? '' : ' max-lg:hidden' }}">
                <header class="flex h-14 shrink-0 items-center gap-2 border-b border-slate-200 px-3">
                    {% if not show_list %}
                        <button type="button" data-shell-target="openButton" data-action="shell#open"
                                aria-label="{{ 'nav.open'|trans }}" aria-controls="main-nav" aria-expanded="false"
                                class="grid size-10 place-items-center rounded-md text-slate-600 hover:bg-slate-100 lg:hidden">
                            {{ ux_icon('lucide:menu', {class: 'size-5', 'aria-hidden': 'true'}) }}
                        </button>
                    {% elseif has_detail %}
                        <a href="{% block back_url %}{% endblock %}" aria-label="{{ 'nav.back'|trans }}"
                           class="grid size-10 place-items-center rounded-md text-slate-600 hover:bg-slate-100 lg:hidden">
                            {{ ux_icon('lucide:arrow-left', {class: 'size-5', 'aria-hidden': 'true'}) }}
                        </a>
                    {% endif %}
                    {% set heading_tag = show_list ? 'h2' : 'h1' %}
                    <{{ heading_tag }} id="detail-heading" class="truncate text-base font-semibold">{% block detail_title %}{% endblock %}</{{ heading_tag }}>
                    <div class="ml-auto flex items-center gap-1">{% block detail_actions %}{% endblock %}</div>
                </header>
                {# long text without links: keyboard users can scroll after focusing the region #}
                <div class="min-h-0 flex-1 overflow-y-auto"{% if detail_scroll_focus|default(false) %} tabindex="0"{% endif %}>
                    {% block detail %}{% endblock %}
                </div>
            </section>
        </main>

        {{ include('_partials/palette.html.twig') }}

        <div class="pointer-events-none fixed inset-x-0 bottom-4 z-50 max-lg:bottom-[calc(4.5rem+env(safe-area-inset-bottom))] flex justify-center px-4" role="status" aria-live="polite">
            <div data-live-counts-target="notice" hidden
                 class="pointer-events-auto flex items-center gap-3 rounded-lg bg-slate-900 py-2 pr-2 pl-4 text-sm text-white shadow-lg">
                {{ ux_icon('lucide:mail', {class: 'size-4', 'aria-hidden': 'true'}) }}
                <span>{{ 'live.new_messages'|trans }}</span>
                <button type="button" data-action="live-counts#reload" class="rounded-md bg-white/15 px-2.5 py-1 font-medium hover:bg-white/25">
                    {{ ux_icon('lucide:refresh-cw', {class: 'mr-1 inline size-3.5', 'aria-hidden': 'true'}) }}{{ 'live.reload'|trans }}
                </button>
                <button type="button" data-action="live-counts#dismiss" class="grid size-7 place-items-center rounded-md hover:bg-white/15" aria-label="{{ 'action.close'|trans }}">
                    {{ ux_icon('lucide:x', {class: 'size-4', 'aria-hidden': 'true'}) }}
                </button>
            </div>
        </div>
    </div>
{% endblock %}
