{% extends 'base.html.twig' %}

{# Schlichtes, zentriertes Layout für Anmeldung, Registrierung usw. #}
{% block body %}
    {{ include('_partials/flashes.html.twig') }}
    <main id="main" class="flex min-h-full flex-col items-center justify-center px-4 py-10">
        <div class="mb-6 flex flex-col items-center gap-2">
            {{ include('_partials/logo.html.twig', {variant: 'line', class: 'size-24 text-brand-600'}) }}
            <span class="text-xl font-semibold">{{ 'app.name'|trans }}</span>
        </div>
        <div class="card w-full max-w-sm p-6 shadow-sm">
            <h1 class="mb-4 text-lg font-semibold">{{ block('title') }}</h1>
            {% block content %}{% endblock %}
        </div>
        {% block below %}{% endblock %}
    </main>
{% endblock %}
