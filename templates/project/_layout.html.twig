{% extends 'layout/app.html.twig' %}
{% import '_partials/ui.html.twig' as ui %}

{% block title %}{{ 'nav.projects'|trans }}{% endblock %}
{% block list_title %}{{ 'nav.projects'|trans }}{% endblock %}
{% block back_url %}{{ path('project_index', archived ? {archived: 1} : {}) }}{% endblock %}

{% block list_actions %}
    <a href="{{ path('project_new') }}" class="btn-icon" aria-label="{{ 'project.new'|trans }}" title="{{ 'project.new'|trans }}">
        {{ ux_icon('lucide:plus', {class: 'size-5', 'aria-hidden': 'true'}) }}
    </a>
{% endblock %}

{% block list %}
    <nav aria-label="{{ 'project.state'|trans }}" class="m-3 flex gap-1 rounded-lg bg-slate-100 p-1 text-sm">
        {% for value, label in {0: 'project.active', 1: 'project.archived'} %}
            {% set active = (value == 1) == archived %}
            <a href="{{ path('project_index', value ? {archived: 1} : {}) }}" {% if active %}aria-current="page"{% endif %}
               class="flex-1 rounded-md px-3 py-1 text-center {{ active ? 'bg-surface font-medium shadow-sm' : 'text-slate-600 hover:text-slate-900' }}">{{ label|trans }}</a>
        {% endfor %}
    </nav>
    {% if projects is empty %}
        {{ ui.empty(archived ? 'project.none_archived' : 'project.none', 'lucide:folder-kanban', archived ? null : path('project_new'), 'empty.project') }}
    {% else %}
        <ul role="list">
            {% for p in projects %}
                <li>{{ ui.list_link(path('project_show', {id: p.id}), project is defined and project and project.id == p.id,
                        p.name, p.organization ? p.organization.name : 'project.personal'|trans,
                        ui.tile(p.name, p.image, p.color)) }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
