{% extends 'project/_layout.html.twig' %}
{% import '_partials/ui.html.twig' as ui %}

{% set has_detail = true %}

{% block title %}{{ project.name }}{% endblock %}
{% block detail_title %}{{ project.name }}{% endblock %}

{% block detail_actions %}
    {% if is_granted('PROJECT_MANAGE', project) %}
        <a href="{{ path('project_edit', {id: project.id}) }}" class="btn-icon" aria-label="{{ 'action.edit'|trans }}" title="{{ 'action.edit'|trans }}">
            {{ ux_icon('lucide:pencil', {class: 'size-4', 'aria-hidden': 'true'}) }}
        </a>
        {{ ui.post_button(path('project_delete', {id: project.id}), 'delete-project-' ~ project.id, 'project.delete',
            {class: 'btn-icon hover:text-red-600', icon: 'lucide:trash-2', icon_only: true, confirm: 'project.delete_confirm'}) }}
    {% endif %}
{% endblock %}

{% block detail %}
    <div class="max-w-3xl space-y-6 p-4 lg:p-6">
        <div class="flex items-start gap-4">
            {{ ui.tile(project.name, project.image, project.color, 'size-16 text-lg') }}
            <div class="min-w-0">
                <p class="text-lg font-semibold">{{ project.name }}</p>
                <p class="text-sm text-slate-500">
                    {% if project.organization %}
                        <a class="link" href="{{ path('organization_show', {id: project.organization.id}) }}">{{ project.organization.name }}</a>
                    {% else %}
                        {{ 'project.personal'|trans }}
                    {% endif %}
                </p>
                {% if project.description %}<p class="mt-2 whitespace-pre-line text-slate-600">{{ project.description }}</p>{% endif %}
            </div>
        </div>

        {% block project_sections %}
            <div class="flex flex-wrap gap-2">
                <a class="btn-secondary" href="{{ path('mail_inbox', {project: project.id}) }}">{{ ux_icon('lucide:mail', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'project.messages'|trans }}</a>
                <a class="btn-secondary" href="{{ path('calendar_month', {project: project.id}) }}">{{ ux_icon('lucide:calendar', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'project.calendar'|trans }}</a>
            </div>
        {% endblock %}
    </div>
{% endblock %}
