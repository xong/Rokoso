{% extends 'project/_layout.html.twig' %}
{% import '_partials/ui.html.twig' as ui %}

{% set has_detail = true %}

{% block title %}{{ project.name }}{% endblock %}
{% block detail_title %}{{ project.name }}{% endblock %}

{% block detail_actions %}
    {{ include('_partials/watch_button.html.twig', {target: project, kind: 'project'}) }}
    {% if is_granted('PROJECT_MANAGE', project) %}
        <a href="{{ path('project_edit', {id: project.id}) }}" class="btn-icon" aria-label="{{ 'action.edit'|trans }}" title="{{ 'action.edit'|trans }}">
            {{ ux_icon('lucide:pencil', {class: 'size-4', 'aria-hidden': 'true'}) }}
        </a>
        {{ ui.post_button(path('project_delete', {id: project.id}), 'delete-project-' ~ project.id, 'project.delete',
            {class: 'btn-icon hover:text-red-600', icon: 'lucide:trash-2', icon_only: true, confirm: 'project.delete_confirm'}) }}
    {% endif %}
{% endblock %}

{% block detail %}
    <div class="flex min-h-full flex-col xl:flex-row">
        <div class="min-w-0 flex-1 space-y-6 p-4 lg:p-6">
            <div class="flex items-start gap-4">
                {{ ui.tile(project.name, project.image, project.color, 'size-16 text-lg') }}
                <div class="min-w-0">
                    <p class="text-lg font-semibold">{{ project.name }}</p>
                    <p class="text-sm text-slate-500">
                        {% if project.organization %}
                            <a class="link" href="{{ path('organization_show', {id: project.organization.id}) }}">{{ project.organization.name }}</a>
                        {% else %}
                            {{ 'project.personal'|trans }}
                        {% endif %}
                    </p>
                    {% if project.description %}<p class="mt-2 whitespace-pre-line text-slate-600">{{ project.description }}</p>{% endif %}
                </div>
            </div>

            {% block project_sections %}
                <div class="flex flex-wrap gap-2">
                    <a class="btn-secondary" href="{{ path('mail_all', {project: project.id}) }}">{{ ux_icon('lucide:mail', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'project.messages'|trans }}</a>
                    <a class="btn-secondary" href="{{ path('calendar_month', {project: project.id}) }}">{{ ux_icon('lucide:calendar', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'project.calendar'|trans }}</a>
                    <a class="btn-secondary" href="{{ path('task_index', {scope: 'all', view: 'board', project: project.id}) }}">{{ ux_icon('lucide:list-checks', {class: 'size-4', 'aria-hidden': 'true'}) }} {{ 'project.task_board'|trans }}</a>
                </div>
            {% endblock %}

            <div class="grid gap-6 lg:grid-cols-2">
                <section aria-labelledby="project-events-heading">
                    <div class="mb-2 flex items-center justify-between gap-2">
                        <h2 id="project-events-heading" class="text-sm font-semibold">{{ 'project.upcoming_events'|trans }}</h2>
                        <a class="link text-sm" href="{{ path('calendar_item_new', {project: project.id}) }}">{{ 'calendar.new_event'|trans }}</a>
                    </div>
                    {% if upcoming_events is empty %}
                        <p class="text-sm text-slate-500">{{ 'project.no_events'|trans }}</p>
                    {% else %}
                        <ul role="list" class="card divide-y divide-slate-100">
                            {% for o in upcoming_events %}
                                <li>
                                    <a href="{{ path('calendar_item_show', {id: o.item.id, date: o.start|date('Y-m-d')}) }}" class="flex items-baseline gap-3 px-3 py-2 hover:bg-slate-50">
                                        <time datetime="{{ o.start|date('c') }}" class="w-28 shrink-0 text-xs text-slate-500 tabular-nums">{{ o.start|date(o.item.allDay ? 'd.m.Y' : 'd.m.Y H:i') }}</time>
                                        <span class="min-w-0 flex-1 truncate">{{ o.item.title }}</span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </section>

                <section aria-labelledby="project-tasks-heading">
                    <div class="mb-2 flex items-center justify-between gap-2">
                        <h2 id="project-tasks-heading" class="text-sm font-semibold">{{ 'project.open_tasks'|trans }}</h2>
                        <a class="link text-sm" href="{{ path('task_index', {scope: 'all', project: project.id}) }}">{{ 'project.all_tasks'|trans }}</a>
                    </div>
                    {% if open_tasks is empty %}
                        <p class="text-sm text-slate-500">{{ 'project.no_tasks'|trans }}</p>
                    {% else %}
                        <ul role="list" class="card divide-y divide-slate-100">
                            {% for task in open_tasks %}
                                <li class="flex items-start gap-2 px-3 py-2">{{ include('task/_row.html.twig', {compact: true}) }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    <a class="link mt-2 inline-block text-sm" href="{{ path('calendar_item_new', {type: 'task', project: project.id}) }}">{{ 'task.new'|trans }}</a>
                </section>
            </div>

            <section aria-labelledby="project-messages-heading">
                <h2 id="project-messages-heading" class="mb-2 text-sm font-semibold">{{ 'project.recent_messages'|trans }}</h2>
                {% if recent_messages is empty %}
                    <p class="text-sm text-slate-500">{{ 'project.no_messages'|trans }}</p>
                {% else %}
                    <ul role="list" class="card divide-y divide-slate-100">
                        {% for m in recent_messages %}
                            <li>
                                <a href="{{ path('mail_show', {folder: 'all', id: m.id, project: project.id}) }}" class="flex items-baseline gap-3 px-3 py-2 hover:bg-slate-50">
                                    <span class="w-32 shrink-0 truncate text-slate-600">{{ m.internal and m.author ? m.author.name : m.fromLabel }}</span>
                                    <span class="min-w-0 flex-1 truncate">{{ m.subject ?: 'mail.no_subject'|trans }}</span>
                                    <time datetime="{{ m.date|date('c') }}" class="shrink-0 text-xs text-slate-500">{{ m.date|short_date }}</time>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            <section aria-labelledby="project-files-heading">
                <div class="mb-2 flex items-center justify-between gap-2">
                    <h2 id="project-files-heading" class="text-sm font-semibold">{{ 'project.files'|trans }}</h2>
                    {% if project.organization %}
                        <a class="link text-sm" href="{{ path('folder_new', {project: project.id}) }}">{{ 'folder.new_for_project'|trans }}</a>
                    {% endif %}
                </div>
                {% if files is empty %}
                    <p class="text-sm text-slate-500">{{ 'project.no_files'|trans }}</p>
                {% else %}
                    <ul role="list" class="card divide-y divide-slate-100">
                        {% for f in files %}
                            <li>
                                <a href="{{ path('file_show', {id: f.id}) }}" class="flex items-center gap-3 px-3 py-2 hover:bg-slate-50">
                                    {{ include('file/_icon.html.twig', {mime: f.mimeType}) }}
                                    <span class="min-w-0 flex-1 truncate">{{ f.filename }}</span>
                                    <span class="shrink-0 text-xs text-slate-500 max-sm:hidden">{{ f.folder.name }}</span>
                                    <span class="shrink-0 text-xs text-slate-500 tabular-nums">{{ f.size|filesize }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            <section aria-labelledby="project-forum-heading">
                <div class="mb-2 flex items-center justify-between gap-2">
                    <h2 id="project-forum-heading" class="text-sm font-semibold">{{ 'project.forum'|trans }}</h2>
                    {% if project.organization %}
                        <a class="link text-sm" href="{{ path('forum_board_new', {project: project.id}) }}">{{ 'forum.board_new_for_project'|trans }}</a>
                    {% endif %}
                </div>
                {% if topics is empty %}
                    <p class="text-sm text-slate-500">{{ 'project.no_topics'|trans }}</p>
                {% else %}
                    {{ include('forum/_topics.html.twig', {show_board: true}) }}
                {% endif %}
            </section>
        </div>

        {{ include('_partials/comments.html.twig', {
            comments: comments,
            add_url: path('project_comment', {id: project.id}),
            delete_route: 'project_comment_delete',
            delete_params: {id: project.id},
            token: 'project-comment',
            mention_org: project.organization,
        }) }}
    </div>
{% endblock %}
